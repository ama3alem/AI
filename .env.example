# Focus Intelligence Engine — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this template is not.
# Every variable is optional except FOCUS_AUTH_SECRET, which is REQUIRED to run in
# production mode. The engine refuses to start unauthenticated in production.
#
# No secret has a default value anywhere in the codebase, and no secret is ever written
# to a log record, a settings repr, or a serialized artifact.

# --- Required in production ----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FOCUS_AUTH_SECRET=

# --- Runtime (optional) --------------------------------------------------------
FOCUS_RUNTIME_ENVIRONMENT=development   # development | test | production
FOCUS_RUNTIME_LOG_LEVEL=INFO
FOCUS_RUNTIME_DETERMINISTIC=true
FOCUS_RUNTIME_DEFAULT_SEED=20260926

# --- Security (optional) -------------------------------------------------------
FOCUS_SEC_AUTH_REQUIRED=false
FOCUS_SEC_RATE_LIMIT_REQUESTS=120
FOCUS_SEC_RATE_LIMIT_WINDOW_SECONDS=60
FOCUS_SEC_MAX_EVENTS_PER_REQUEST=1000
# Comma-separated explicit origins. A wildcard "*" is rejected by design.
# FOCUS_SEC_CORS_ALLOW_ORIGINS=https://app.example.org

# --- Paths (optional; must be absolute) ----------------------------------------
# FOCUS_PATH_PROJECT_ROOT=
# FOCUS_PATH_DATA_DIR=
# FOCUS_PATH_ARTIFACTS_DIR=
# FOCUS_PATH_REPORTS_DIR=
